# ========================================
# WebGenix Docker Environment Configuration
# ========================================
# Copy this file to .env and fill in your values:
#   cp .env.docker .env
# ========================================

# ----------------------------------------
# Application
# ----------------------------------------
NODE_ENV=production

# ----------------------------------------
# MongoDB
# ----------------------------------------
MONGO_ROOT_USERNAME=webgenix_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_password_here

# ----------------------------------------
# JWT Secrets (generate with: openssl rand -hex 32)
# ----------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_generate_random_32_char_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_different_32_char_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ----------------------------------------
# Security
# ----------------------------------------
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# ----------------------------------------
# URLs
# ----------------------------------------
# Backend URL (used by frontend to call API)
# For local: http://localhost/api
# For production: https://your-domain.com/api
VITE_API_URL=http://localhost/api

# Client URL (used by backend for CORS and email links)
# For local: http://localhost
# For production: https://your-domain.com
CLIENT_URL=http://localhost

# ----------------------------------------
# Razorpay (Payment Gateway - India)
# ----------------------------------------
# Get these from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# Frontend Razorpay key (public)
VITE_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME

# ----------------------------------------
# Email (SMTP - Optional)
# ----------------------------------------
# For Gmail: use App Password, not regular password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=CHANGE_ME_app_specific_password
EMAIL_FROM=noreply@webgenix.com
